# Порт на хосте. Внутри контейнера сервис слушает 8080.
SPUTNIK_PORT=18080

# 127.0.0.1 для локального доступа или reverse proxy на хосте.
# 0.0.0.0 для публикации порта на всех IPv4-интерфейсах.
SPUTNIK_BIND_HOST=127.0.0.1

# Постоянное хранилище лимитов и телеметрии. Замените пароль перед запуском.
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Необязательно: URI внешнего PostgreSQL вместо контейнера db.
DATABASE_URL=

# Публичный адрес сервиса для OAuth callback и защиты POST-запросов.
# Пусто = http://127.0.0.1:<SPUTNIK_PORT>. На хостинге задайте HTTPS-домен.
APP_URL=

# OpenAI-совместимый Chat Completions API. Ключ хранится только на сервере.
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_LOCAL_MODE=false
AI_MODEL=deepseek-flash
# Для DeepSeek Flash можно указать none; для других моделей проверьте поддержку.
AI_REASONING_EFFORT=none
# Весь ответ: текст и JSON карточек объектов/продуктов.
AI_MAX_OUTPUT_TOKENS=4096
AI_MAX_PROMPT_BYTES=30000
AI_TIMEOUT_SECONDS=40
AI_SESSION_TOKENS=60000
AI_ANON_DAILY_TOKENS=200000
AI_SESSION_REQUESTS=30
AI_IP_DAILY_REQUESTS=40
# Необязательно: IP или CIDR ваших reverse proxy через запятую.
# X-Forwarded-For учитывается только от этих адресов.
TRUSTED_PROXY_NETWORKS=
SESSION_DAYS=1
TELEMETRY_DAYS=30

# Яндекс OAuth: тип web, разрешение login:info,
# Redirect URI = <APP_URL>/auth/callback.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# Числовые id пользователей Яндекс через запятую (предпочтительно).
# Также поддерживается точный логин Яндекса без @домена, проверенный через OAuth.
# Для старой сессии потребуется повторный вход, чтобы получить проверенный логин.
ADMIN_YANDEX_IDS=

# Локальный справочник работает всегда. Внешние Nominatim/Wikidata — после заполнения User-Agent.
# Перед включением ознакомьтесь с политикой поставщика.
GEOCODER_URL=https://nominatim.openstreetmap.org
# Пример: Sputnik/1.0 (https://your-domain.ru; contact@your-domain.ru)
GEOCODER_USER_AGENT=
GEOCODER_ATTRIBUTION=© OpenStreetMap contributors

# Для Ollama, запущенной на хосте Docker Desktop:
# AI_BASE_URL=http://host.docker.internal:11434/v1
# AI_API_KEY=ollama
# AI_MODEL=<имя установленной локальной модели>
# AI_LOCAL_MODE=true
# AI_REASONING_EFFORT=none
# AI_TIMEOUT_SECONDS=120
